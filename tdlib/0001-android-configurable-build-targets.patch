 BUILD_SHARED_LIBS=$5
+ANDROID_ABIS=${ANDROID_ABIS:-"arm64-v8a armeabi-v7a x86_64 x86"}
+read -r -a ABI_LIST <<< "$ANDROID_ABIS"
+
+if [ ${#ABI_LIST[@]} -eq 0 ] ; then
+  echo 'Error: ANDROID_ABIS must contain at least one ABI.'
+  exit 1
+fi
+for ABI in "${ABI_LIST[@]}" ; do
+  case "$ABI" in
+    arm64-v8a|armeabi-v7a|x86_64|x86) ;;
+    *)
+      echo "Error: unsupported Android ABI: $ABI"
+      exit 1
+      ;;
+  esac
+done
 
