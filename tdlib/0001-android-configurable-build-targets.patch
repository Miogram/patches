diff --git a/example/android/build-openssl.sh b/example/android/build-openssl.sh
--- a/example/android/build-openssl.sh
+++ b/example/android/build-openssl.sh
@@ -5,6 +5,22 @@ ANDROID_NDK_VERSION=${2:-23.2.8568313}
